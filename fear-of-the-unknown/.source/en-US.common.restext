Resource_Gain1Insanity2Creepy_MoveMob=Gain 1 {icon:insanity_icon}, Gain 2 {icon:creepy_icon}, Move the {icon:angrymob_icon}.
Resource_Gain2Creepy=Gain 2 {icon:creepy_icon}.
Resource_Gain2Dollars=Gain $2.
Resource_Gain2Insanity1Creepy=Gain 2 {icon:insanity_icon}, Gain 1 {icon:creepy_icon}.
